<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="icon" type="image/png" href="{{ root }}assets/logo.png">
<style>
  /* Light, sober palette from the BC Roma logo: warm near-black text, the logo gold only as accent (borders, rules, tints);
     links and small accents use a deeper gold so every text colour keeps a contrast of 5:1 or more on white. */
  :root { color-scheme: light; --paper:#fff; --soft:#faf7ef; --tint:#f5ebcb; --flag:#fbf6e6; --ink:#1f1b14; --muted:#5e584b;
          --line:#e7e1d3; --gold:#e8b018; --link:#7a5600; --win:#1e7b45; --loss:#b3302f; }
  body { margin:0; background:var(--paper); color:var(--ink); font:16px/1.65 system-ui, -apple-system, "Segoe UI", sans-serif; }
  a { color:var(--link); }
  a:hover { color:var(--ink); }
  header { border-bottom:3px solid var(--gold); padding:12px 16px; background:var(--paper); }
  .bar { max-width:980px; margin:0 auto; display:flex; gap:10px 16px; align-items:center; flex-wrap:wrap; }
  .brand { display:flex; align-items:center; gap:12px; text-decoration:none; color:var(--muted); font-size:.78rem; letter-spacing:.03em; text-transform:uppercase; }
  .brand img { height:32px; width:auto; background:none; border-radius:0; display:block; }
  .bar > a:not(.brand) { color:var(--ink); text-decoration:none; font-weight:500; }
  .bar > a:not(.brand):hover { color:var(--link); text-decoration:underline; }
  main { max-width:980px; margin:0 auto; padding:12px 16px 56px; }
  img { max-width:100%; height:auto; background:#fff; border-radius:4px; }
  h1 { margin:1.2rem 0 .6rem; line-height:1.25; }
  h1::after { content:""; display:block; width:56px; height:3px; background:var(--gold); margin-top:.5rem; }
  h2 { border-bottom:1px solid var(--line); padding-bottom:4px; margin-top:2.2rem; }
  h3 { margin-top:1.6rem; }
  td img { max-width:none; width:44px; height:54px; object-fit:cover; object-position:top; border-radius:6px; display:block; }
  td img.face { display:inline-block; width:34px; height:42px; vertical-align:middle; margin-right:8px; }
  table { border-collapse:collapse; display:block; overflow-x:auto; }
  th { background:var(--tint); color:var(--ink); border-bottom:2px solid var(--gold); }
  th, td { padding:5px 10px; border-bottom:1px solid var(--line); white-space:nowrap; }
  .mark { background:#fff2a8; color:var(--ink); padding:0 3px; border-radius:3px; }
  blockquote { margin:1rem 0; padding:.5rem 1rem; border-left:4px solid var(--gold); background:var(--flag); color:var(--ink); border-radius:0 6px 6px 0; }
  blockquote p { margin:.3rem 0; }
  code { background:var(--soft); padding:0 4px; border-radius:3px; }
  details { margin:.8rem 0; } summary { cursor:pointer; font-weight:600; }
  .cards { display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); margin-top:1rem; }
  .card { display:block; padding:14px 16px; border:1px solid var(--line); border-radius:8px; background:var(--soft); text-decoration:none; color:var(--ink); }
  .card:hover { border-color:var(--gold); background:var(--flag); color:var(--ink); }
  .card .rd { color:var(--muted); font-size:.85rem; }
  .card .score { font-size:1.35rem; font-weight:700; }
  .win { color:var(--win); } .loss { color:var(--loss); }
  .latest { border-left:5px solid var(--gold); }
  select { font:inherit; padding:5px 8px; border:1px solid #cfc7b3; border-radius:6px; background:var(--paper); color:var(--ink); width:210px; max-width:100%; }
  select:focus-visible, a:focus-visible, summary:focus-visible { outline:2px solid var(--link); outline-offset:2px; }
  .doc table { display:table; width:100%; }
  .doc th, .doc td { white-space:normal; text-align:left; vertical-align:top; }
  .edit { margin:.6rem 0 0; font-size:.9rem; }
  .edit a { font-weight:600; }
  .hl { background:#ffe27a !important; box-shadow:inset 0 0 0 1px #c99a00; }
  body.hl-mode main table td { cursor:cell; }
  .hl-tools { position:fixed; right:16px; bottom:16px; display:flex; gap:8px; z-index:5; }
  .hl-tools button { font:inherit; font-size:.85rem; padding:6px 12px; border:1px solid var(--gold); border-radius:999px; background:var(--paper); color:var(--ink); cursor:pointer; box-shadow:0 1px 4px rgba(0,0,0,.15); }
  .hl-tools button[aria-pressed="true"] { background:var(--gold); }
  .hl-tools button:focus-visible { outline:2px solid var(--link); outline-offset:2px; }
  @media print { .hl-tools, .edit { display:none; } }
  .muted { color:var(--muted); font-size:.9rem; }
  .comments { margin-top:3rem; }
</style>
</head>
<body>
<header><div class="bar">
  <a class="brand" href="{{ root }}"><img src="{{ root }}assets/logo.png" alt="BC Roma"><span>{{ season }} &middot; weekly report</span></a>
  <select aria-label="Opponents" onchange="if(this.value)location.href='{{ root }}'+this.value">
    <option value="">Opponents &#9662;</option>
    {% for o in nav.games %}<option value="{{ o.url }}">{{ o.label }}</option>
    {% endfor %}
  </select>
  <a href="{{ root }}#reviews">Game reviews</a>
  {% for pg in nav.pages %}<a href="{{ root }}{{ pg.url }}">{{ pg.label }}</a>
  {% endfor %}
</div></header>
<main>
{% if edit_url %}<p class="edit"><a href="{{ edit_url }}" target="_blank" rel="noopener">&#9998; Edit the text of this page</a>
<span class="muted">opens its markdown file on GitHub; once saved, the site is rebuilt within a few minutes</span></p>{% endif %}
{{ body }}
{% if comments and comments_repo %}<section class="comments">
<h2>Comments</h2>
<p class="muted">Anyone with a GitHub account can comment here; the comments are kept as a GitHub issue of the repository, one per page.</p>
<script src="https://utteranc.es/client.js" repo="{{ comments_repo }}" issue-term="pathname" label="{{ comments_label }}" theme="github-light" crossorigin="anonymous" async></script>
</section>{% endif %}
</main>
<div class="hl-tools" id="hl-tools" hidden>
  <button type="button" id="hl-clear" hidden>Clear highlights</button>
  <button type="button" id="hl-toggle" aria-pressed="false" title="Click table cells to highlight them (shift-click: the whole row). Kept in this browser only.">&#9998; Highlighter</button>
</div>
<script>
// Live highlighter: with it on, a click on a table cell highlights it (shift-click: the row). Saved in this browser only.
(function () {
  var tables = [].slice.call(document.querySelectorAll("main table"));
  if (!tables.length) return;
  var KEY = "bcroma-highlights:" + location.pathname, saved = [];
  try { saved = JSON.parse(localStorage.getItem(KEY) || "[]"); } catch (e) {}
  var cells = [].slice.call(document.querySelectorAll("main table td"));
  var id = function (td) { return tables.indexOf(td.closest("table")) + ":" + td.parentNode.rowIndex + ":" + td.cellIndex; };
  var store = function () { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (e) {} };
  var set = function (td, on) { var k = id(td), i = saved.indexOf(k); td.classList.toggle("hl", on);
                                if (on && i < 0) saved.push(k); if (!on && i >= 0) saved.splice(i, 1); };
  cells.forEach(function (td) { if (saved.indexOf(id(td)) >= 0) td.classList.add("hl"); });
  var tools = document.getElementById("hl-tools"), toggle = document.getElementById("hl-toggle"), clear = document.getElementById("hl-clear");
  tools.hidden = false;
  toggle.addEventListener("click", function () {
    var on = toggle.getAttribute("aria-pressed") !== "true";
    toggle.setAttribute("aria-pressed", on); document.body.classList.toggle("hl-mode", on); clear.hidden = !on;
  });
  clear.addEventListener("click", function () { cells.forEach(function (td) { td.classList.remove("hl"); }); saved = []; store(); });
  document.addEventListener("click", function (ev) {
    if (!document.body.classList.contains("hl-mode")) return;
    var td = ev.target.closest && ev.target.closest("main table td");
    if (!td) return;
    ev.preventDefault();
    var targets = ev.shiftKey ? [].slice.call(td.parentNode.cells).filter(function (c) { return c.tagName === "TD"; }) : [td];
    var on = !td.classList.contains("hl");
    targets.forEach(function (c) { set(c, on); }); store();
  });
})();
</script>
</body>
</html>
