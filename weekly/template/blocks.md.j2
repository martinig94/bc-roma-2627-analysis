{% macro comparison(a, files, author, kind) -%}
**{{ a.team }}**: {{ a.comparison.team.record }}, {{ a.comparison.team.position }}{{ a.team_suffix }}, last five {{ a.comparison.team.form }} · **{{ a.opponent }}**: {{ a.comparison.opp.record }}, {{ a.comparison.opp.position }}{{ a.opp_suffix }}, last five {{ a.comparison.opp.form }}

| | {{ a.team }} | {{ a.opponent }} |
|---|---:|---:|
{% for r in a.comparison.rows %}| {{ r.stat }} | {{ r.team }} | {{ r.opp }} |
